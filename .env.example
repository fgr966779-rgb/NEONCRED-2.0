# =============================================================================
# PiggyVault (SaveQuest 2.0) — Environment Variables EXAMPLE
# =============================================================================
# Copy this file to .env and fill in your real API keys.
# This file is safe to commit — it contains only placeholder descriptions.
# =============================================================================

# AI / LLM
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Banking — PrivatBank (Ukraine)
PRIVATBANK_MERCHANT_ID=your-merchant-id
PRIVATBANK_PASSWORD=your-password
PRIVATBANK_CARD_NUMBER=516874xxxxxxxxxxxx

# Banking — Plaid (International)
PLAID_CLIENT_ID=your-client-id
PLAID_SECRET=your-secret
PLAID_ENV=sandbox

# Financial Data
TWELVE_DATA_API_KEY=your-twelve-data-key
SERPAPI_KEY=your-serpapi-key

# 3D / AR
SKETCHFAB_API_KEY=your-sketchfab-token

# Receipt Scanning
MINDEE_API_KEY=your-mindee-key
GOOGLE_VISION_API_KEY=your-google-vision-key

# Crypto
OKX_API_KEY=your-okx-api-key
OKX_SECRET_KEY=your-okx-secret-key
OKX_PASSPHRASE=your-okx-passphrase

# Firebase
FIREBASE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# Price Comparison
PRICEAPI_KEY=your-priceapi-key
COUPON_API_KEY=your-couponapi-key

# Email / Price Match
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Amazon Product Advertising API
AMAZON_ACCESS_KEY=AKIAxxxxxxxxxxxxxxxx
AMAZON_SECRET_KEY=your-amazon-secret-key
AMAZON_PARTNER_TAG=your-partner-tag-21

# Price Intelligence
PREDICTHQ_API_KEY=your-predicthq-key
OLX_API_KEY=your-olx-api-key

# Voice / Audio
ASR_API_KEY=your-asr-key
TTS_API_KEY=your-tts-key

# App Config
DB_NAME=piggyvault.db
APP_ENV=development
DEBUG_LOGGING=true
